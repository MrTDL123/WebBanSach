@page "/management/login"
@layout Layout.AuthLayout
@using Microsoft.AspNetCore.Components.Authorization
@using WebApp.Admin.Services.Interfaces
@using WebApp.Admin.Validation

@inject NavigationManager Navigation
@inject IAuthClientService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject UserSessionState UserSessionState

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            <h2 class="brand-title">Nhà sách Văn Hóa Truyền Thống</h2>
            <p class="subtitle">Hệ thống quản trị nhà sách Văn Hóa Truyền Thống</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">
                @_errorMessage
            </div>
        }

        @if (_validationErrors != null && _validationErrors.Any())
        {
            <div class="alert alert-danger">
                <ul>
                    @foreach (var err in _validationErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }

        <EditForm Model="@_loginModel" OnValidSubmit="HandleSubmitAsync" FormName="AdminLoginForm">
            <FluentValidator/>

            <div class="form-group">
                <label for="email">Tài khoản / Email</label>
                <InputText id="email" class="form-control" @bind-Value="_loginModel.UsernameOrEmail" placeholder="admin@webbansach.com" />
                <ValidationMessage For="@(() => _loginModel.UsernameOrEmail)" class="validation-message" />
            </div>

            <div class="form-group">
                <label for="password">Mật khẩu</label>
                <div class="input-password-group">
                    <InputText id="password" type="@(_showPwd ? "text" : "password")" class="form-control input-control" @bind-Value="_loginModel.Password" placeholder="••••••••" />
                    <button type="button" class="toggle-pwd-btn" @onclick="TogglePwd">
                        <i class="fa-solid @(_showPwd ? "fa-eye" : "fa-eye-slash")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => _loginModel.Password)" class="validation-message" />
            </div>

            <div class="form-remember">
                <label>
                    <InputCheckbox @bind-Value="_rememberMe" id="GhiNhoDangNhap" /> Ghi nhớ đăng nhập
                </label>
                <a href="/management/forgot-password" class="forgot">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn-login" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span class="spinner"></span>
                    <span>Đang xử lý...</span>
                }
                else
                {
                    <span>ĐĂNG NHẬP</span>
                }
            </button>
        </EditForm>
    </div>
</div>