@page "/management/forgot-password"
@layout Layout.AuthLayout
@using WebApp.Admin.Services.Interfaces
@using WebApp.Admin.Validation

@inject NavigationManager Navigation
@inject IAuthClientService AuthClientService

<div class="auth-card">
    <EditForm EditContext="@_editContext">
        <FluentValidator/>

        @if (_currentStep == 1)
        {
            <h2 class="auth-title">QUÊN MẬT KHẨU</h2>
            <p class="auth-subtitle">Nhập email quản trị để nhận mã xác thực OTP</p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert-danger">
                    @_errorMessage
                </div>
            }

            @if (_validationErrors != null && _validationErrors.Any())
            {
                <div class="alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in _validationErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }

            <div class="form-group">
                <label for="email">Email tài khoản</label>
                <div class="input-group">
                    <InputText id="email" type="email" class="form-control" placeholder="admin@webbansach.com"
                               @bind-Value="_forgotPasswordModel.Email" disabled="@_isOtpSent" />

                    <button type="button" class="btn-otp"
                            disabled="@(!CanSendOtp || _isSubmitting)"
                            @onclick="HandleSendOtp">
                        @(_isTimerRunning ? $"{_countdownSeconds}s" : "Gửi OTP")
                    </button>
                </div>
                <ValidationMessage For="@(() => _forgotPasswordModel.Email)" />
            </div>

            <div class="form-group">
                <label for="otp">Mã xác thực OTP</label>
                <InputText id="otp" class="form-control" placeholder="Nhập 6 số OTP"
                           @bind-Value="_forgotPasswordModel.OtpCode" disabled="@(!_isOtpSent)" maxlength="6" />
                <ValidationMessage For="@(() => _forgotPasswordModel.OtpCode)" />
            </div>

            <button type="button" class="btn-submit" disabled="@(!CanVerifyOtp || _isSubmitting)" @onclick="HandleVerifyOtp">
                @if (_isSubmitting)
                {
                    <span>ĐANG XỬ LÝ...</span>
                }
                else
                {
                    <span>XÁC NHẬN MÃ OTP</span>
                }
            </button>
        }
        else
        {
            <h2 class="auth-title">ĐẶT LẠI MẬT KHẨU</h2>
            <p class="auth-subtitle">Tạo mật khẩu mới cho tài khoản của bạn</p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert-danger">
                    @_errorMessage
                </div>
            }

            @if (_validationErrors != null && _validationErrors.Any())
            {
                <div class="alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in _validationErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }

            <div class="form-group">
                <label for="newPassword">Mật khẩu mới</label>
                <div class="password-group">
                    <InputText id="newPassword" type="@(_showNewPassword ? "text" : "password")" class="form-control" placeholder="••••••••"
                               @bind-Value="_forgotPasswordModel.NewPassword" />
                    <button type="button" class="btn-eye" @onclick="ToggleShowNewPassword" aria-label="Toggle password visibility">
                        <i class="fa-solid @(_showNewPassword ? "fa-eye" : "fa-eye-slash")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => _forgotPasswordModel.NewPassword)" />
            </div>

            <div class="form-group">
                <label for="confirmPassword">Xác nhận mật khẩu mới</label>
                <div class="password-group">
                    <InputText id="confirmPassword" type="@(_showConfirmPassword ? "text" : "password")" class="form-control" placeholder="••••••••"
                               @bind-Value="_forgotPasswordModel.ConfirmNewPassword" />
                    <button type="button" class="btn-eye" @onclick="ToggleShowConfirmPassword" aria-label="Toggle password visibility">
                        <i class="fa-solid @(_showConfirmPassword ? "fa-eye" : "fa-eye-slash")"></i>
                    </button>
                </div>
                <ValidationMessage For="@(() => _forgotPasswordModel.ConfirmNewPassword)" />
            </div>

            <button type="button" class="btn-submit" disabled="@(!CanResetPassword || _isSubmitting)" @onclick="HandleResetPassword">
                @if (_isSubmitting)
                {
                    <span>ĐANG XỬ LÝ...</span>
                }
                else
                {
                    <span>LƯU MẬT KHẨU</span>
                }
            </button>
        }

        <div class="auth-footer">
            <a href="/management/login" class="back-link">← Quay lại đăng nhập</a>
        </div>
    </EditForm>
</div>