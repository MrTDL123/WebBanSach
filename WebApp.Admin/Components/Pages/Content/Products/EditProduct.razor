@page "/management/content/products/edit/{Id:int}"
@using WebApp.Admin.Services.Interfaces
@using WebApp.Shared.Dtos.Management.ContentAndMarketing
@using WebApp.Admin.Validation
@inject IContentClientService ContentClientService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin,ContentManager")]

<div class="page-container">
    <header class="page-header">
        <div class="header-title">
            <h1>Chỉnh sửa sản phẩm</h1>
            <p class="subtitle">Cập nhật thông tin chi tiết, giá và trạng thái hiển thị</p>
        </div>
        <div class="header-actions">
            <a href="/management/content/products" class="btn btn-secondary">Quay lại danh sách</a>
        </div>
    </header>

    @if (_isLoading)
    {
        <div class="state-container">
            <div class="spinner"></div>
            <p>Đang tải dữ liệu sản phẩm...</p>
        </div>
    }
    else
    {
        <section class="form-card">
            <EditForm Model="@_updateProductModel" OnValidSubmit="HandleSubmitAsync" class="product-form">
                <FluentValidator />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-error">@_errorMessage</div>
                }

                <div class="form-grid">
                    <!-- Cột trái: Thông tin chính -->
                    <div class="form-column">
                        <div class="form-group">
                            <label for="title">Tên sách <span class="required">*</span></label>
                            <InputText id="title" @bind-Value="_updateProductModel.Title" class="form-control" placeholder="Nhập tên sách..." />
                            <ValidationMessage For="@(() => _updateProductModel.Title)" />
                        </div>

                        <div class="form-row form-row-2">
                            <div class="form-group">
                                <label for="categoryId">Danh mục <span class="required">*</span></label>
                                <InputSelect id="categoryId" @bind-Value="_updateProductModel.CategoryId" class="form-control">
                                    <option value="0">-- Chọn danh mục --</option>
                                    @foreach (var cat in _categories)
                                    {
                                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _updateProductModel.CategoryId)" />
                            </div>

                            <div class="form-group">
                                <label for="authorId">Tác giả <span class="required">*</span></label>
                                <InputSelect id="authorId" @bind-Value="_updateProductModel.AuthorId" class="form-control">
                                    <option value="0">-- Chọn tác giả --</option>
                                    @foreach (var aut in _authors)
                                    {
                                        <option value="@aut.AuthorId">@aut.AuthorName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _updateProductModel.AuthorId)" />
                            </div>
                        </div>

                        <div class="form-row form-row-2">
                            <div class="form-group">
                                <label for="publisherId">Nhà xuất bản <span class="required">*</span></label>
                                <InputSelect id="publisherId" @bind-Value="_updateProductModel.PublisherId" class="form-control">
                                    <option value="0">-- Chọn NXB --</option>
                                    @foreach (var pub in _publishers)
                                    {
                                        <option value="@pub.PublisherId">@pub.PublisherName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _updateProductModel.PublisherId)" />
                            </div>

                            <div class="form-group">
                                <label for="supplier">Nhà cung cấp / Đối tác</label>
                                <InputText id="supplier" @bind-Value="_updateProductModel.SupplierName" class="form-control" placeholder="Tên nhà cung cấp..." />
                                <ValidationMessage For="@(() => _updateProductModel.SupplierName)" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="description">Mô tả nội dung sách</label>
                            <InputTextArea id="description" @bind-Value="_updateProductModel.Description" class="form-control text-area" rows="6" />
                            <ValidationMessage For="@(() => _updateProductModel.Description)" />
                        </div>
                    </div>

                    <!-- Cột phải: Giá, kho, trạng thái và ảnh -->
                    <div class="form-column">
                        <div class="form-group">
                            <label for="isActive">Trạng thái kinh doanh</label>
                            <InputSelect id="isActive" @bind-Value="_updateProductModel.IsActive" class="form-control">
                                <option value="true">Đang bán (Hiển thị ngoài Website)</option>
                                <option value="false">Đã ẩn / Ngừng kinh doanh</option>
                            </InputSelect>
                        </div>

                        <div class="form-row form-row-3">
                            <div class="form-group">
                                <label for="price">Giá gốc (đ) <span class="required">*</span></label>
                                <InputNumber id="price" @bind-Value="_updateProductModel.Price" class="form-control" />
                                <ValidationMessage For="@(() => _updateProductModel.Price)" />
                            </div>

                            <div class="form-group">
                                <label for="discount">Giảm giá (%)</label>
                                <InputNumber id="discount" @bind-Value="_updateProductModel.DiscountPercent" class="form-control" />
                                <ValidationMessage For="@(() => _updateProductModel.DiscountPercent)" />
                            </div>

                            <div class="form-group">
                                <label for="stock">Số lượng tồn kho <span class="required">*</span></label>
                                <InputNumber id="stock" @bind-Value="_updateProductModel.StockQuantity" class="form-control" disabled/>
                            </div>
                        </div>

                        <!-- Thay đổi ảnh bìa -->
                        <div class="form-group">
                            <label>Hình ảnh bìa chính</label>
                            <div class="image-upload-box">
                                @if (!string.IsNullOrEmpty(_previewMainImage))
                                {
                                    <div class="image-preview">
                                        <img src="@_previewMainImage" alt="Preview" />
                                        <button type="button" class="btn-remove-img" @onclick="RemoveMainImage">✕</button>
                                    </div>
                                }
                                else
                                {
                                    <label for="mainImageInputEdit" class="upload-label">
                                        <span class="upload-icon">📷</span>
                                        <span>Chọn ảnh mới để thay thế</span>
                                    </label>
                                }
                                <InputFile id="mainImageInputEdit" OnChange="HandleMainImageSelected" accept="image/*" class="file-input-hidden" />
                            </div>
                        </div>

                        <!-- Khu vực ảnh phụ không giới hạn -->
                        <div class="gallery-section">
                            <p class="gallery-section-title">Ảnh phụ (Album sản phẩm)</p>
                            <p class="gallery-section-subtitle">Thêm nhiều ảnh để khách hàng xem chi tiết sách. Có thể thêm không giới hạn số lượng.</p>
                            <div class="gallery-grid">
                                @foreach (var item in _galleryImages.Where(x => !x.IsDeleted))
                                {
                                    <div class="gallery-item">
                                    <img src="@GetGalleryImageSrc(item)" alt="Ảnh phụ @item.DisplayOrder" />
                                        <button type="button" class="btn-remove-gallery" @onclick="() => RemoveGalleryImage(item)">✕</button>
                                    </div>
                                }
                                <!-- Ô thêm ảnh mới -->
                                <label for="galleryInput" class="gallery-add-btn">
                                    <span class="gallery-add-icon">+</span>
                                    <span>Thêm ảnh</span>
                                </label>
                                <InputFile id="galleryInput" OnChange="HandleGalleryImagesSelected"
                                           accept="image/*" multiple class="file-input-hidden" />
                            </div>
                        </div>
                    </div>
                </div>

                <footer class="form-actions">
                    <a href="/management/content/products" class="btn btn-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                        @(_isSubmitting ? "Đang lưu..." : "Cập nhật thay đổi")
                    </button>
                </footer>
            </EditForm>
        </section>
    }
</div>