@page "/management/profile"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using WebApp.Admin.Services.Interfaces
@using WebApp.Admin.Validation
@using WebApp.Shared.Dtos.User

@inject AuthenticationStateProvider AuthStateProvider
@inject IUserClientService UserClientService
@inject IJSRuntime JSRuntime

<div class="profile-layout">

    <!-- KHU VỰC SIDEBAR (MENU TRÁI) -->
    <aside class="profile-sidebar">
        <div class="sidebar-card">
            <button type="button" class="menu-item @(_activeTab == "info" ? "active" : "")" @onclick='() => ChangeTab("info")'>
                <i class="fa-regular fa-user"></i> Thông tin tài khoản
            </button>
            <button type="button" class="menu-item @(_activeTab == "password" ? "active" : "")" @onclick='() => ChangeTab("password")'>
                <i class="fa-solid fa-lock"></i> Đổi mật khẩu tài khoản
            </button>
            <button type="button" class="menu-item @(_activeTab == "2fa" ? "active" : "")" @onclick='() => ChangeTab("2fa")'>
                <i class="fa-solid fa-shield-halved"></i> Xác minh 2 bước
            </button>
        </div>
    </aside>

    <!-- KHU VỰC NỘI DUNG CHÍNH (PHẢI) -->
    <main class="profile-content">
        <div class="content-card">

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert-msg alert-error">@_errorMessage</div>
            }
            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="alert-msg alert-success">@_successMessage</div>
            }

            @* ================= TAB 1: THÔNG TIN TÀI KHOẢN ================= *@
            @if (_activeTab == "info")
            {
                <h2 class="section-title">THÔNG TIN TÀI KHOẢN</h2>

                <!-- Khu vực đổi Avatar -->
                <div class="avatar-section">
                    <div class="avatar-wrapper">
                        <img src="@GetAvatarDisplayUrl()" alt="Avatar" class="avatar-img">
                        <label for="avatarUpload" class="avatar-upload-btn" title="Thay đổi ảnh đại diện">
                            <i class="fa-solid fa-camera"></i>
                        </label>
                        <!-- Dùng InputFile của Blazor thay cho input HTML -->
                        <InputFile id="avatarUpload" OnChange="HandleAvatarSelected" class="hidden-input" accept="image/*" style="display:none;"/>
                    </div>
                </div>

                <!-- Form thông tin -->
                <EditForm Model="@_updateProfileModel" OnValidSubmit="HandleUpdateProfileAsync" class="profile-form" >
                    <FluentValidator />

                    <!-- Tên và Ngày sinh -->
                    <div class="form-row form-row-2">
                        <div class="form-group">
                            <label>Họ và tên</label>
                            <InputText @bind-Value="_updateProfileModel.FullName" class="input-control" placeholder="Nhập họ và tên..." />
                            <ValidationMessage For="@(() => _updateProfileModel.FullName)" />
                        </div>
                        <div class="form-group">
                            <label>Ngày sinh</label>
                            <InputDate @bind-Value="_updateProfileModel.DateOfBirth" class="input-control" />
                            <ValidationMessage For="@(() => _updateProfileModel.DateOfBirth)" />
                        </div>
                    </div>

                    <!-- Email và Số điện thoại -->
                    <div class="form-row form-row-2">
                        <div class="form-group">
                            <label>Email</label>
                            <div class="input-group">
                                <input type="text" class="input-control input-readonly" value="@(_userProfileModel?.Email)" readonly />
                                <button type="button" class="btn-action" @onclick="OpenChangeEmailModal">Thay đổi</button>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Số điện thoại</label>
                            <div class="input-group">
                                <input type="text" class="input-control input-readonly" value="@(_userProfileModel?.PhoneNumber)" readonly />
                                <button type="button" class="btn-action" @onclick="OpenChangePhoneModal">Thay đổi</button>
                            </div>
                        </div>
                    </div>

                    <!-- Khu vực Địa chỉ (Rút gọn chỉ còn Địa chỉ chi tiết) -->
                    <div class="form-group mt-16">
                        <label>Địa chỉ chi tiết (Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành...)</label>
                        <InputText @bind-Value="_updateProfileModel.Address" class="input-control" placeholder="Nhập địa chỉ chi tiết đầy đủ..." />
                        <ValidationMessage For="@(() => _updateProfileModel.Address)" />
                    </div>

                    <!-- Nút Lưu -->
                    <div class="form-actions">
                        <button type="submit" class="btn-save" disabled="@_isSubmittingProfile">
                            @(_isSubmittingProfile ? "Đang lưu..." : "Lưu")
                        </button>
                    </div>
                </EditForm>
            }

            @* ================= TAB 2: ĐỔI MẬT KHẨU ================= *@
            @if (_activeTab == "password")
            {
                <h2 class="section-title">TẠO MẬT KHẨU MỚI</h2>

                <div class="password-form-wrapper">
                    <EditForm Model="@_passwordModel" OnValidSubmit="HandleChangePasswordAsync" class="profile-form">
                        <FluentValidator />

                        <div class="form-group">
                            <label>Mật khẩu hiện tại</label>
                            <div class="input-password-group">
                                <InputText type="@(_showCurrentPwd ? "text" : "password")" @bind-Value="_passwordModel.CurrentPassword" class="input-control" />
                                <button type="button" class="toggle-pwd-btn" @onclick="ToggleCurrentPwd">
                                    <i class="fa-solid @(_showCurrentPwd ? "fa-eye" : "fa-eye-slash")"></i>
                                </button>
                            </div>
                            <ValidationMessage For="@(() => _passwordModel.CurrentPassword)" />
                        </div>

                        <div class="form-group">
                            <label>Mật khẩu mới</label>
                            <div class="input-password-group">
                                <InputText type="@(_showNewPwd ? "text" : "password")" @bind-Value="_passwordModel.NewPassword" class="input-control" />
                                <button type="button" class="toggle-pwd-btn" @onclick="ToggleNewPwd">
                                    <i class="fa-solid @(_showNewPwd ? "fa-eye" : "fa-eye-slash")"></i>
                                </button>
                            </div>
                            <ValidationMessage For="@(() => _passwordModel.NewPassword)" />
                        </div>

                        <div class="form-group">
                            <label>Nhập lại mật khẩu mới</label>
                            <div class="input-password-group">
                                <InputText type="@(_showConfirmPwd ? "text" : "password")" @bind-Value="_passwordModel.ConfirmNewPassword" class="input-control" />
                                <button type="button" class="toggle-pwd-btn" @onclick="ToggleConfirmPwd">
                                    <i class="fa-solid @(_showConfirmPwd ? "fa-eye" : "fa-eye-slash")"></i>
                                </button>
                            </div>
                            <ValidationMessage For="@(() => _passwordModel.ConfirmNewPassword)" />
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-save" disabled="@_isSubmittingPassword">
                                @(_isSubmittingPassword ? "Đang xử lý..." : "Lưu")
                            </button>
                        </div>
                    </EditForm>
                </div>
            }

            @* ================= TAB 3: XÁC MINH 2 BƯỚC ================= *@
            @if (_activeTab == "2fa")
            {
                <div class="two-fa-section">
                    <div class="two-fa-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <h3 class="two-fa-title">Xác thực thông tin tài khoản</h3>
                    <p class="two-fa-desc">Để bảo vệ quyền riêng tư, vui lòng chọn hình thức xác nhận mã OTP (Tính năng đang nâng cấp):</p>

                    <div class="two-fa-actions">
                        <button type="button" class="btn-2fa" disabled>
                            <i class="fa-regular fa-envelope"></i> Email
                        </button>
                        <button type="button" class="btn-2fa" disabled>
                            <i class="fa-solid fa-mobile-screen-button"></i> SMS
                        </button>
                    </div>
                </div>
            }
        </div>
    </main>
</div>