@page "/"
@page "/management/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using WebApp.Admin.Services.Interfaces

@inject IDashboardClientService DashboardClientService
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<main class="dashboard-container">
    <!-- Header -->
    <header class="dashboard-header">
        <h1 class="dashboard-title">Bảng Thống Kê & Phân Tích Hoạt Động (BI)</h1>
        <p class="dashboard-subtitle">Bấm vào từng thẻ chỉ số bên dưới để xem báo cáo chi tiết</p>
    </header>
    @if (_isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Đang tổng hợp dữ liệu báo cáo...</p>
        </div>
    }
    else if (_dashBoardStateModel != null)
    {
        <!-- ================= KHU VỰC 1: 4 THẺ KPI ĐÓNG VAI TRÒ LÀ NÚT CHỌN TAB ================= -->
        <section class="kpi-grid">
            <!-- 1. Tab Tài chính -->
            <article class="kpi-card theme-revenue @(_activeTab == "revenue" ? "active" : "")" @onclick='() => SelectTabAsync("revenue")'>
                <div class="kpi-icon"><i class="fa-solid fa-sack-dollar"></i></div>
                <div class="kpi-info">
                    <span class="kpi-label">Tổng Doanh Thu</span>
                    <strong class="kpi-value">@_dashBoardStateModel.TotalRevenue.ToString("N0") ₫</strong>
                    <div class="kpi-sub">
                        <span>AOV: <strong>@_dashBoardStateModel.AverageOrderValue.ToString("N0") ₫</strong></span>
                        <span class="badge @(_dashBoardStateModel.RevenueGrowthPercent >= 0 ? "badge-success" : "badge-danger")">
                            @(_dashBoardStateModel.RevenueGrowthPercent >= 0 ? "+" : "")@_dashBoardStateModel.RevenueGrowthPercent% MoM
                        </span>
                    </div>
                </div>
            </article>
            <!-- 2. Tab Vận hành & Đơn hàng -->
            <article class="kpi-card theme-order @(_activeTab == "orders" ? "active" : "")" @onclick='() => SelectTabAsync("orders")'>
                <div class="kpi-icon"><i class="fa-solid fa-truck-fast"></i></div>
                <div class="kpi-info">
                    <span class="kpi-label">Tổng Đơn Hàng</span>
                    <strong class="kpi-value">@_dashBoardStateModel.TotalOrders đơn</strong>
                    <div class="kpi-sub">
                        <span class="text-success">Giao đạt: <strong>@_dashBoardStateModel.OrderSuccessRate%</strong></span>
                        <span class="text-warning">Chờ duyệt: <strong>@_dashBoardStateModel.PendingOrders</strong></span>
                    </div>
                </div>
            </article>
            <!-- 3. Tab Kho bãi & Sản phẩm -->
            <article class="kpi-card theme-warehouse @(_activeTab == "warehouse" ? "active" : "")" @onclick='() => SelectTabAsync("warehouse")'>
                <div class="kpi-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
                <div class="kpi-info">
                    <span class="kpi-label">Tồn Kho & Vốn</span>
                    <strong class="kpi-value">@_dashBoardStateModel.TotalStockQuantity cuốn</strong>
                    <div class="kpi-sub">
                        <span>Đầu sách: <strong>@_dashBoardStateModel.TotalProducts</strong> SKU</span>
                        <span>Vốn: <strong>@_dashBoardStateModel.TotalInventoryValue.ToString("N0") ₫</strong></span>
                    </div>
                </div>
            </article>
            <!-- 4. Tab Khách hàng -->
            <article class="kpi-card theme-customer @(_activeTab == "customers" ? "active" : "")" @onclick='() => SelectTabAsync("customers")'>
                <div class="kpi-icon"><i class="fa-solid fa-users-viewfinder"></i></div>
                <div class="kpi-info">
                    <span class="kpi-label">Khách Hàng</span>
                    <strong class="kpi-value">@_dashBoardStateModel.TotalCustomers</strong>
                    <div class="kpi-sub">
                        <span class="text-primary">Mới: <strong>+@_dashBoardStateModel.NewCustomersThisMonth</strong></span>
                        <span>Mua lại: <strong>@_dashBoardStateModel.RepeatCustomerRate%</strong></span>
                    </div>
                </div>
            </article>
        </section>
        <!-- ================= KHU VỰC CHI TIẾT THAY ĐỔI THEO TAB ĐANG CHỌN ================= -->
        @if (_activeTab == "revenue")
        {
            <!-- TAB 1: PHÂN TÍCH DOANH THU & TÀI CHÍNH -->
            <section class="detail-layout">
                <article class="panel panel-main">
                    <header class="panel-header">
                        <h2 class="panel-title text-primary"><i class="fa-solid fa-chart-column"></i> Xu hướng Doanh thu 6 Tháng gần nhất</h2>
                    </header>
                    <div class="chart-container">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </article>
                <article class="panel panel-side">
                    <header class="panel-header">
                        <h2 class="panel-title"><i class="fa-solid fa-file-invoice-dollar"></i> Tổng kết Tài chính</h2>
                    </header>
                    <div class="stat-summary-list">
                        <div class="stat-summary-item">
                            <span>Doanh thu tháng này</span>
                            <strong class="text-primary">@_dashBoardStateModel.RevenueThisMonth.ToString("N0") ₫</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Giá trị trung bình đơn (AOV)</span>
                            <strong>@_dashBoardStateModel.AverageOrderValue.ToString("N0") ₫</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Tăng trưởng so tháng trước</span>
                            <strong class="@(_dashBoardStateModel.RevenueGrowthPercent >= 0 ? "text-success" : "text-danger")">
                                @(_dashBoardStateModel.RevenueGrowthPercent >= 0 ? "+" : "")@_dashBoardStateModel.RevenueGrowthPercent%
                            </strong>
                        </div>
                    </div>
                </article>
            </section>
        }
        else if (_activeTab == "orders")
        {
            <!-- TAB 2: VẬN HÀNH & ĐƠN HÀNG -->
            <section class="detail-layout">
                <article class="panel panel-main">
                    <header class="panel-header">
                        <h2 class="panel-title text-info"><i class="fa-solid fa-chart-pie"></i> Tỷ lệ Phân bổ Trạng thái Đơn hàng</h2>
                    </header>
                    <div class="chart-container">
                        <canvas id="orderStatusChart"></canvas>
                    </div>
                </article>
                <article class="panel panel-side">
                    <header class="panel-header">
                        <h2 class="panel-title"><i class="fa-solid fa-list-check"></i> Thống kê Vận chuyển</h2>
                    </header>
                    <div class="stat-summary-list">
                        <div class="stat-summary-item">
                            <span>Giao thành công</span>
                            <strong class="text-success">@_dashBoardStateModel.CompletedOrders đơn (@_dashBoardStateModel.OrderSuccessRate%)</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Chờ duyệt / Đóng gói</span>
                            <strong class="text-warning">@(_dashBoardStateModel.PendingOrders + _dashBoardStateModel.ProcessingOrders) đơn</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Đang vận chuyển</span>
                            <strong class="text-info">@_dashBoardStateModel.ShippingOrders đơn</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Hủy / Trả hàng</span>
                            <strong class="text-danger">@(_dashBoardStateModel.CancelledOrders + _dashBoardStateModel.ReturnedOrders) đơn</strong>
                        </div>
                    </div>
                </article>
            </section>
        }
        else if (_activeTab == "warehouse")
        {
            <!-- TAB 3: KHO BÃI & THỂ LOẠI SÁCH -->
            <section class="detail-layout">
                <article class="panel panel-main">
                    <header class="panel-header">
                        <h2 class="panel-title text-danger"><i class="fa-solid fa-book-bookmark"></i> Phân bổ Doanh thu theo Thể loại Sách</h2>
                    </header>
                    <div class="chart-container">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </article>
                <article class="panel panel-side">
                    <header class="panel-header">
                        <h2 class="panel-title"><i class="fa-solid fa-warehouse"></i> Tồn kho</h2>
                    </header>
                    <div class="stock-list">
                        <div class="stock-item theme-success">
                            <div class="stock-label">
                                <span>Tồn kho an toàn (>5 cuốn)</span>
                                <strong>@_dashBoardStateModel.HealthyStockCount SKU</strong>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill" style="width: @(_dashBoardStateModel.TotalProducts > 0 ? (_dashBoardStateModel.HealthyStockCount * 100 / _dashBoardStateModel.TotalProducts) : 0)%"></div>
                            </div>
                        </div>
                        <div class="stock-item theme-warning">
                            <div class="stock-label">
                                <span>Sắp hết hàng (1 - 5 cuốn)</span>
                                <strong>@_dashBoardStateModel.LowStockCount SKU</strong>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill" style="width: @(_dashBoardStateModel.TotalProducts > 0 ? (_dashBoardStateModel.LowStockCount * 100 / _dashBoardStateModel.TotalProducts) : 0)%"></div>
                            </div>
                        </div>
                        <div class="stock-item theme-danger">
                            <div class="stock-label">
                                <span>Đã hết hàng (0 cuốn)</span>
                                <strong>@_dashBoardStateModel.OutOfStockCount SKU</strong>
                            </div>
                            <div class="progress-track">
                                <div class="progress-fill" style="width: @(_dashBoardStateModel.TotalProducts > 0 ? (_dashBoardStateModel.OutOfStockCount * 100 / _dashBoardStateModel.TotalProducts) : 0)%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="distribution-grid mt-3">
                        <div class="stat-mini">
                            <span class="stat-mini-label">Sách thương mại</span>
                            <strong class="stat-mini-value">@_dashBoardStateModel.BookDistribution.CommercialBookCount</strong>
                        </div>
                        <div class="stat-mini">
                            <span class="stat-mini-label">Sách 0 đồng</span>
                            <strong class="stat-mini-value">@_dashBoardStateModel.BookDistribution.FreeBookCount</strong>
                        </div>
                        <div class="stat-mini">
                            <span class="stat-mini-label">Sách ủng hộ</span>
                            <strong class="stat-mini-value">@_dashBoardStateModel.BookDistribution.DonationBookCount</strong>
                        </div>
                    </div>
                </article>
            </section>
        }
        else if (_activeTab == "customers")
        {
            <!-- TAB 4: PHÂN KHÚC KHÁCH HÀNG -->
            <section class="detail-layout">
                <article class="panel panel-main">
                    <header class="panel-header">
                        <h2 class="panel-title text-purple"><i class="fa-solid fa-users"></i> Phân khúc Khách hàng Mua sắm</h2>
                    </header>
                    <div class="chart-container">
                        <canvas id="customerChart"></canvas>
                    </div>
                </article>
                <article class="panel panel-side">
                    <header class="panel-header">
                        <h2 class="panel-title"><i class="fa-solid fa-chart-line"></i> Chỉ số Khách hàng</h2>
                    </header>
                    <div class="stat-summary-list">
                        <div class="stat-summary-item">
                            <span>Khách mới trong tháng</span>
                            <strong class="text-primary">+@_dashBoardStateModel.NewCustomersThisMonth khách</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Tỷ lệ khách mua lại (>= 2 đơn)</span>
                            <strong class="text-success">@_dashBoardStateModel.RepeatCustomerRate%</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Đã từng mua hàng</span>
                            <strong>@_dashBoardStateModel.CustomersWithOrders khách</strong>
                        </div>
                        <div class="stat-summary-item">
                            <span>Chưa phát sinh đơn</span>
                            <strong class="text-muted">@_dashBoardStateModel.CustomersWithoutOrders khách</strong>
                        </div>
                    </div>
                </article>
            </section>
        }
    }
</main>