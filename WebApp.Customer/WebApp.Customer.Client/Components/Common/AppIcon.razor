@namespace WebApp.Customer.Client.Components.Common

<svg class="app-icon @Class" 
     width="@Size" 
     height="@Size" 
     aria-hidden="@(string.IsNullOrEmpty(AriaLabel) ? "true" : "false")"
     aria-label="@AriaLabel"
     role="@(string.IsNullOrEmpty(AriaLabel) ? "presentation" : "img")">
    <use href="/images/icons-sprite.svg#icon-@Name" />
</svg>

@code {
    /// <summary>
    /// Mã định danh icon trong sprite sheet (không cần gõ tiền tố "icon-")
    /// Ví dụ: "cart", "user", "book", "eye", "lightning"
    /// </summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty; 

    /// <summary>
    /// Kích thước hiển thị (pixels, mặc định 18px)
    /// </summary>
    [Parameter]
    public int Size { get; set; } = 18;

    /// <summary>
    /// Class CSS tùy biến bổ sung
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Nhãn hỗ trợ thiết bị trợ thính (Accessibility)
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }
}
