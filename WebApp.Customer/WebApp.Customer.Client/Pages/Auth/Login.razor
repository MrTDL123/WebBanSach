@page "/dang-nhap"

@using Microsoft.AspNetCore.Components.Authorization
@using WebApp.Customer.Client.Services.Interfaces
@using WebApp.Customer.Client.Validation
@using WebApp.Shared.Dtos.Customer.Auth
@rendermode InteractiveAuto

@inject IAuthClientService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Đăng nhập | Nhà Sách Văn Hóa</PageTitle>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h2 class="auth-title">ĐĂNG NHẬP</h2>
            <p class="auth-subtitle">Chào mừng bạn quay lại với Nhà Sách Văn Hóa</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-danger">
                <span>@errorMessage</span>
            </div>
        }

        @if (validationErrors != null && validationErrors.Any())
        {
            <div class="alert-danger">
                <ul>
                    @foreach (var err in validationErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="HandleSubmitAsync" FormName="CustomerLoginForm">
            <FluentValidator />
            
            <div class="form-group"> 
                <label for="EmailOrPhone" class="form-label">Tài khoản (Email hoặc SĐT)</label>
                <InputText id="EmailOrPhone" 
                           @bind-Value="loginModel.EmailOrPhone" 
                           class="form-control" 
                           placeholder="Nhập email hoặc số điện thoại..." />
                <ValidationMessage For="@(() => loginModel.EmailOrPhone)" />
            </div>

            <div class="form-group">
                <label for="MatKhau" class="form-label">Mật khẩu</label>
                <div class="password-wrapper">
                    <InputText type="@(showPassword ? "text" : "password")" 
                               id="MatKhau" 
                               @bind-Value="loginModel.Password" 
                               class="form-control input-password" 
                               placeholder="Nhập mật khẩu..." />
                    <button type="button" class="btn-toggle-password" @onclick="TogglePasswordVisibility" tabindex="-1">
                        <AppIcon Name="@(showPassword ? "eye-slash" : "eye")" Size="18" />
                    </button>
                </div>
                <ValidationMessage For="@(() => loginModel.Password)" />
            </div>

            <div class="form-options">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="rememberMe" id="GhiNhoDangNhap" class="checkbox-input" />
                    <span>Ghi nhớ đăng nhập</span>
                </label>
                <a href="/quen-mat-khau" class="link-forgot">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn-primary" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="btn-spinner"></span>
                    <span>Đang xử lý...</span>
                }
                else
                {
                    <span>ĐĂNG NHẬP</span>
                }
            </button>

            <div class="auth-divider">
                <span class="divider-line"></span>
                <span class="divider-text">HOẶC</span>
                <span class="divider-line"></span>
            </div>

            <a href="/dang-ky" class="btn-secondary">
                TẠO TÀI KHOẢN MỚI
            </a>

            <div class="social-group">
                <a href="api/auth/google-login" class="btn-social google-btn">
                    <AppIcon Name="google" Size="18" />
                    <span>Đăng nhập với Google</span>
                </a>

                <a href="api/auth/facebook-login" class="btn-social facebook-btn">
                    <AppIcon Name="facebook" Size="18" />
                    <span>Đăng nhập với Facebook</span>
                </a>
            </div>
        </EditForm>
    </div>
</div>