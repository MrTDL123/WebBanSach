@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using WebApp.Customer.Client
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Nhà sách văn hóa truyền thống</title>
    <ResourcePreloader />
    <link rel="preload"
          href="/fonts/PlayfairDisplay-Bold.woff2"
          as="font"
          type="font/woff2"
          crossorigin="anonymous" />

    <link rel="preload"
          href="/fonts/BeVietnamPro-Regular.woff2"
          as="font"
          type="font/woff2"
          crossorigin="anonymous" />
    
    <link rel="preload"
          href="/images/icons-sprite.svg"
          as="image"
          type="image/svg+xml" />
    

    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["WebApp.Customer.styles.css"]" />

    <SectionOutlet SectionName="DynamicPagePreloads" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveAuto" />
</head>

<body>
    <Routes @rendermode="InteractiveAuto" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
